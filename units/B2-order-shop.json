{
  "id": "B2-order-shop",
  "description": "주문 가능 상점 상세(조회 전용). 오라클은 패치 0008로 연 shop/true 화면. A4처럼 이미지 위 투명 고정 헤더라 헤더까지 전체 비교(chrome none). 장바구니 막대 자리는 '앱에서 주문하기' CTA로 대체(스펙 차이, 2026-10-10 사용자 결정): 후보 전용 요소로 존재만 확인하고 비교에서 제외, 장바구니 요청은 무시",
  "oracle": { "app": "order", "commit": "1b51c34", "path": "/shop/true/{shopId}" },
  "candidate": { "app": "web", "path": "/order/shops/{shopId}" },
  "device": "Pixel 5",
  "chrome": "none",
  "primaryRequest": "/stage/order/shop/\\d+/summary",
  "candidateOnly": [
    { "selector": "[data-order-cta]", "reason": "웹은 주문 불가: 장바구니 막대 자리를 '앱에서 주문하기' CTA로 항상 표시(order는 장바구니에 물건이 있을 때만 막대 표시)" }
  ],
  "states": [
    { "name": "default", "auth": "guest", "params": { "shopId": 2 }, "cassette": "shop-2", "requiredText": ["굿모닝살로만치킨"] },
    { "name": "image-viewer", "auth": "guest", "params": { "shopId": 2 }, "cassette": "shop-2", "actions": [{ "click": { "role": "button", "name": "slide 0" } }], "requiredText": [] },
    { "name": "takeout-only", "auth": "guest", "params": { "shopId": 3 }, "cassette": "shop-3", "requiredText": ["김밥천국"] },
    { "name": "no-image", "auth": "guest", "params": { "shopId": 10 }, "cassette": "shop-10", "requiredText": ["천안문"] }
  ],
  "normalize": {
    "paths": {},
    "ignoreRequests": [
      { "method": "GET", "path": "/cart", "reason": "웹은 장바구니가 없음(CTA로 대체). order는 비로그인이어도 장바구니를 조회하고 401이면 빈 장바구니로 대체" }
    ]
  }
}
