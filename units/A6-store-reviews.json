    },
    {
      "name": "auth",
      "auth": "auth",
      "params": { "shopId": 21 },
      "cassette": "auth-21",
      "requiredText": ["수정", "삭제", "신고하기"]
    },
    {
      "name": "auth-mine-only",
      "auth": "auth",
      "params": { "shopId": 21 },
      "cassette": "auth-21",
      "actions": [{ "click": { "text": "내가 작성한 리뷰" } }],
      "requiredText": ["수정", "삭제"]
    },
    {
      "name": "auth-delete-confirm",
      "auth": "auth",
      "params": { "shopId": 21 },
      "cassette": "auth-21",
      "actions": [{ "click": { "role": "button", "name": "삭제" } }],
      "requiredText": ["삭제 하시겠습니까?", "삭제하기"]
    }
